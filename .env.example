DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_HTTPS=0
DJANGO_HSTS_SECONDS=0
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
DOMAIN=localhost
NGINX_TEMPLATE=./deploy/nginx/http.conf.template
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=
CONTACT_LOCAL_MODE=0
CONTACT_TRUST_PROXY=0
